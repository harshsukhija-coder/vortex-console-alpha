# Leave empty to use same-origin /api
# (Vite proxies to localhost:3001, Vercel proxies to vortex-engine-alpha)
# Set only if you want the browser to call the backend directly (needs CORS).
VITE_API_BASE_URL=

# Set to false to disable the daily meter-reading reminder modal and badge.
VITE_METER_READING_REMINDER_ENABLED=true
