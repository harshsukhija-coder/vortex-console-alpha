{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["bom1"],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vortex-engine-alpha.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
